{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "location": { "root": "apps/location-service" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "location" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
