# sudoku-service — real-time PvP Sudoku WebSocket server

# Port the WebSocket/HTTP server listens on.
PORT=4111

# Go auth-service base URL (JWKS endpoint is derived as <url>/api/auth/jwks).
# Used to verify optional JWTs so signed-in players are identified by account.
AUTH_SERVICE_URL=http://localhost:3100

# Match length in seconds (the countdown). Default 300 (5:00). Lower it for
# deterministic smoke/timer testing.
MATCH_DURATION_SECS=300
