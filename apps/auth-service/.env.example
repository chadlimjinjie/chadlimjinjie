# auth-service — multi-tenant OIDC identity provider

# Port the HTTP server listens on.
PORT=4112

# Postgres connection string. Migrations run on start.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth

# Origin the gateway is reached on (no path, no trailing slash). Token issuers and mail
# links are built from it, and hosted form posts must carry it as their Origin.
PUBLIC_URL=http://localhost:9080

# Origin of the web-accounts console. Used on first start to register its OIDC client.
CONSOLE_URL=http://localhost:5174

# Extra browser origins (comma separated) allowed to call the token, userinfo and
# management endpoints. CONSOLE_URL is always allowed.
CORS_ORIGINS=

# The console operator. Without ADMIN_PASSWORD a random password is generated on first
# start and written to the log once. While ADMIN_PASSWORD is set, the operator is restored
# with it on every start (also the way back in after a lockout); unset it to manage the
# password in the console.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# SMTP for verification and password-reset mail, e.g. smtps://user:pass@smtp.example.com.
# When unset, mails are written to the log instead.
SMTP_URL=
MAIL_FROM=auth@localhost
